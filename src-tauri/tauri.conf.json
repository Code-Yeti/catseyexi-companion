{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CatseyeXI Companion",
  "version": "0.1.0",
  "identifier": "com.ffxi.catseyecompanion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CatseyeXI Companion",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/maps/**",
          "$APPDATA/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/reference.db"
    ]
  }
}
